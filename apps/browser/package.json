{
  "name": "@browserskills/browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@browserskills/contracts": "0.1.0",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1"
  }
}
