{
  "name": "browserskills",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["contracts", "apps/browser", "apps/web"],
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:system": "esbuild tests/e2e/run-system.ts --bundle --platform=node --format=esm --packages=external --outfile=.cache/run-system.mjs && node .cache/run-system.mjs",
    "test:rfb": "esbuild tests/e2e/run-system.ts --bundle --platform=node --format=esm --packages=external --outfile=.cache/run-system.mjs && node .cache/run-system.mjs --rfb"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.13",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
